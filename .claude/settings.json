{
  "permissions": {
    "allow": [
      "Bash(git add -A)",
      "Bash(git add .)",
      "Bash(git add -- *)",
      "Bash(git commit -m *)",
      "Bash(git commit --amend *)",
      "Bash(git push origin main)",
      "Bash(git push origin *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git mv *)",
      "Bash(python3 src/*)",
      "Bash(python3 hel-agent-workbench/src/*)"
    ],
    "deny": [
      "Bash(git rm *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git clean -fd *)",
      "Bash(rm -rf *)"
    ]
  }
}
